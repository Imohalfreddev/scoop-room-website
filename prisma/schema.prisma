// Scoop Room — Prisma schema
//
// This is the relational model backing the site once
// NEXT_PUBLIC_USE_MOCK_API=false (see src/lib/db/prisma.ts and
// src/lib/repository/articles.db.ts). With the flag left at its default
// (true), the frontend runs entirely on src/lib/mock/* and no database is
// required.
//
// To activate:
//   1. Provision Postgres and set DATABASE_URL in .env
//   2. npx prisma migrate dev --name init
//   3. npx prisma db seed (see prisma/seed.ts)
//   4. Set NEXT_PUBLIC_USE_MOCK_API=false

generator client {
  // Required to run on Cloudflare Workers: Workers can't execute Prisma's
  // native Rust query engine (no arbitrary native binaries in the
  // sandbox). `engineType = "client"` (GA since Prisma 6.16, we're on
  // 6.19) removes the Rust/WASM query engine entirely — Prisma Client
  // becomes pure TypeScript and talks to Postgres directly through the
  // driver adapter below. This also sidesteps the classic
  // "query_engine_bg.wasm not found" Wrangler bundling failure that the
  // older previewFeatures = ["driverAdapters"] setup (WASM engine still
  // present) is prone to. Using the "prisma-client" provider (not
  // "prisma-client-js") because Prisma's own docs say the Rust-free path
  // is only thoroughly tested with "prisma-client" — see
  // src/generated/prisma for the output, and src/lib/db/prisma.ts for
  // where it's imported from. Talks to Postgres over node-postgres (`pg`)
  // via Workers' TCP socket support. Keep the datasource provider below
  // as "postgresql", NOT "cockroachdb" — Prisma's pg driver adapter
  // explicitly rejects the "cockroachdb" provider, even though CockroachDB
  // itself is what's actually running behind this connection. CockroachDB
  // speaks the Postgres wire protocol and this schema uses no
  // CockroachDB-specific syntax, so "postgresql" is the correct provider
  // here regardless of which Postgres-compatible engine is on the other
  // end.
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum ArticleType {
  NEWS
  BLOG
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum UserRole {
  ADMIN
  EDITOR
  AUTHOR
  CONTRIBUTOR
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(CONTRIBUTOR)
  avatarUrl    String?
  title        String?
  bio          String?
  twitter      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  articles     Article[]

  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  color       String?
  articles    Article[]

  @@map("categories")
}

model Tag {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  articles Article[] @relation("ArticleTags")

  @@map("tags")
}

model MediaAsset {
  id           String     @id @default(cuid())
  type         MediaType
  url          String
  thumbnailUrl String?
  alt          String
  caption      String?
  width        Int?
  height       Int?
  sizeKb       Int?
  folder       String?
  createdAt    DateTime   @default(now())

  articlesCover Article[] @relation("ArticleCoverImage")
  galleryOf     Article[] @relation("ArticleGallery")

  @@map("media_assets")
}

model Article {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  dek              String
  excerpt          String
  content          String        @db.Text
  coverImageId     String?
  coverImage       MediaAsset?   @relation("ArticleCoverImage", fields: [coverImageId], references: [id])
  gallery          MediaAsset[]  @relation("ArticleGallery")
  videoUrl         String?

  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  tags             Tag[]         @relation("ArticleTags")

  authorId         String
  author           User          @relation(fields: [authorId], references: [id])

  status           ArticleStatus @default(DRAFT)
  type             ArticleType   @default(NEWS)
  featured         Boolean       @default(false)
  trending         Boolean       @default(false)
  sponsored        Boolean       @default(false)

  publishedAt      DateTime?
  scheduledFor     DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  readTimeMinutes  Int           @default(4)
  views            Int           @default(0)

  metaTitle        String?
  metaDescription  String?
  canonicalUrl     String?
  ogImage          String?
  noIndex          Boolean       @default(false)

  comments         Comment[]

  @@index([status, publishedAt])
  @@index([type, status, publishedAt])
  @@index([categoryId])
  @@map("articles")
}

model Comment {
  id           String   @id @default(cuid())
  articleId    String
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorName   String
  authorAvatar String?
  body         String   @db.Text
  createdAt    DateTime @default(now())

  @@index([articleId])
  @@map("comments")
}

model NewsletterSubscriber {
  id            String   @id @default(cuid())
  email         String   @unique
  source        String?
  subscribedAt  DateTime @default(now())
  unsubscribedAt DateTime?

  @@map("newsletter_subscribers")
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

model AdSlotConfig {
  id         String   @id @default(cuid())
  placement  String
  label      String
  images     String[] @default([])
  href       String?
  advertiser String?
  active     Boolean  @default(true)

  @@map("ad_slot_configs")
}
